<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fiskaltrust.AndroidLauncher.LogsPage"
             Appearing="OnAppearing"
             Disappearing="OnDisappearing">

    <Shell.TitleView>
        <Picker x:Name="DateLogPicker" SelectedIndexChanged="OnDateLogPickerSelectedIndexChanged" />
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Export Current" Order="Secondary" Clicked="OnExportCurrentClicked" />
        <ToolbarItem Text="Export All" Order="Secondary" Clicked="OnExportAllClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView x:Name="Scroll">
        <Label x:Name="LogView"
               FontFamily="IosevkaRegular"/>
    </ScrollView>

</ContentPage>
