<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fiskaltrust.AndroidLauncher.LogsPage"
             Appearing="OnAppearing"
             Disappearing="OnDisappearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Copy Logs" Order="Secondary" Clicked="OnCopyLogsClicked" />
        <ToolbarItem Text="Save Logs" Order="Secondary" Clicked="OnSaveLogsClicked" />
        <ToolbarItem x:Name="ClearLogsMenuItem" Text="Clear Logs" Order="Secondary" Clicked="OnClearLogsClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView x:Name="Scroll">
        <Label x:Name="LogView"
               FontFamily="IosevkaRegular"/>
    </ScrollView>

</ContentPage>
