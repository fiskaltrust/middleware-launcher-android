<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:fiskaltrust.AndroidLauncher"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="fiskaltrust.AndroidLauncher.LogsPage"
             Shell.BackgroundColor="{StaticResource Primary}"
             Appearing="OnAppearing"
             Disappearing="OnDisappearing">

    <Shell.TitleView>
        <Grid BackgroundColor="{StaticResource Primary}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDateLabelTapped" />
            </Grid.GestureRecognizers>
            <HorizontalStackLayout VerticalOptions="Center"
                                   HorizontalOptions="Start"
                                   Spacing="4">
                <Label x:Name="DateLabel"
                       VerticalOptions="Center"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Image Source="{mi:Material Icon=ArrowDropDown, IconColor=White}"
                       VerticalOptions="Center"
                       HeightRequest="22"
                       WidthRequest="22" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <ScrollView x:Name="Scroll">
            <Label x:Name="LogView"
                   FontFamily="IosevkaRegular"/>
        </ScrollView>

        <Grid x:Name="DatePopupOverlay" IsVisible="False" BackgroundColor="#88000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPopupBackgroundTapped" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="{StaticResource White}"
                    StrokeShape="RoundRectangle 12"
                    VerticalOptions="Center"
                    Margin="24">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupPanelTapped" />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,420,Auto">
                    <Label Grid.Row="0"
                           Text="Select a day to view"
                           Margin="16,12,16,6"
                           FontAttributes="Bold"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />

                    <CollectionView Grid.Row="1"
                                    x:Name="DateList"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:LogDayItem">
                                <Grid Padding="16,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDateRowTapped" />
                                    </Grid.GestureRecognizers>
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Label}" FontSize="15">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="Viewing"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource White}"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsCurrent}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,Auto,Auto"
                          Padding="16,10"
                          ColumnSpacing="20">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Clicked="OnPopupCancelClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Gray500}"
                                HorizontalOptions="Start" />
                        <Button Grid.Column="1"
                                Text="Export current"
                                Clicked="OnExportCurrentClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}" />
                        <Button Grid.Column="2"
                                Text="Export all"
                                Clicked="OnExportAllClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
