<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label" x:Key="FtLabelBase">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.219" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource FtLabelBase}" />

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
    </Style>

    <Style TargetType="Label" x:Key="FtDisplay" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="1.067" />
    </Style>

    <Style TargetType="Label" x:Key="FtHeadline" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="1.138" />
    </Style>

    <Style TargetType="Label" x:Key="FtTitleLarge" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="1.086" />
    </Style>

    <Style TargetType="Label" x:Key="FtTitleMedium" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontFamily" Value="RobotoMedium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.28" />
    </Style>

    <Style TargetType="Label" x:Key="FtBodyLarge" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.28" />
    </Style>

    <Style TargetType="Label" x:Key="FtBodyMedium" BasedOn="{StaticResource FtLabelBase}" />

    <Style TargetType="Label" x:Key="FtBodySmall" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.138" />
    </Style>

    <Style TargetType="Label" x:Key="FtLabelLarge" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontFamily" Value="RobotoMedium" />
        <Setter Property="CharacterSpacing" Value="0.114" />
    </Style>

    <Style TargetType="Label" x:Key="FtLabelMedium" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontFamily" Value="RobotoMedium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.138" />
        <Setter Property="CharacterSpacing" Value="0.667" />
    </Style>

    <Style TargetType="Label" x:Key="FtLabelSmall" BasedOn="{StaticResource FtLabelBase}">
        <Setter Property="FontFamily" Value="RobotoMedium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="1.241" />
        <Setter Property="CharacterSpacing" Value="2.182" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style TargetType="Button" x:Key="FtFilledButton">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtOnPrimary}, Dark={StaticResource FtOnPrimaryNight}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontFamily" Value="RobotoMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="0.114" />
        <Setter Property="TextTransform" Value="None" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FtSurfaceDisabled}, Dark={StaticResource FtSurfaceDisabledNight}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource FtFilledButton}" />

    <Style TargetType="Button" x:Key="FtOutlinedButton" BasedOn="{StaticResource FtFilledButton}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FtWhite}, Dark={StaticResource FtWhiteNight}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style TargetType="Button" x:Key="FtTextButton" BasedOn="{StaticResource FtFilledButton}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Button" x:Key="FtDangerButton" BasedOn="{StaticResource FtFilledButton}">
        <Setter Property="TextColor" Value="{StaticResource FtOnDanger}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FtDanger}, Dark={StaticResource FtDangerNight}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FtBorder}, Dark={StaticResource FtBorderNight}}" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FtHairline}, Dark={StaticResource FtHairlineNight}}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource FtWhite}, Dark={StaticResource FtWhiteNight}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource FtSurfaceDisabled}, Dark={StaticResource FtSurfaceDisabledNight}}" />
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
        <Setter Property="CancelButtonColor" Value="{AppThemeBinding Light={StaticResource FtIconDefault}, Dark={StaticResource FtIconDefaultNight}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource FtTextSecondary}, Dark={StaticResource FtTextSecondaryNight}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FtWhite}, Dark={StaticResource FtWhiteNight}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource FtWhite}, Dark={StaticResource FtWhiteNight}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource FtIconDefault}, Dark={StaticResource FtIconDefaultNight}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource FtOnSurface}, Dark={StaticResource FtOnSurfaceNight}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource FtTextDisabled}, Dark={StaticResource FtTextDisabledNight}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource FtNavInactive}, Dark={StaticResource FtNavInactiveNight}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource FtWhite}, Dark={StaticResource FtWhiteNight}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource FtPrimary}, Dark={StaticResource FtPrimaryNight}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource FtNavInactive}, Dark={StaticResource FtNavInactiveNight}}" />
    </Style>

</ResourceDictionary>
