<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:fiskaltrust.AndroidLauncher.Resources"
             xmlns:helpers="clr-namespace:fiskaltrust.AndroidLauncher.Helpers"
             x:Class="fiskaltrust.AndroidLauncher.ManageSpaceView"
             BackgroundColor="{StaticResource FtScrim}">

    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnScrimTapped" />
    </ContentView.GestureRecognizers>

    <Border WidthRequest="312"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{AppThemeBinding Light={StaticResource FtWhite}, Dark={StaticResource FtWhiteNight}}">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.14" Radius="12" Offset="0,8" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer />
        </Border.GestureRecognizers>

        <VerticalStackLayout>
            <VerticalStackLayout Padding="24,24,24,0">
                <Border WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FtDangerContainer}, Dark={StaticResource FtDangerContainerNight}}">
                    <Label Text="{x:Static helpers:FaIcons.Trash}"
                           FontFamily="{x:Static helpers:FaIcons.FontFamily}"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource FtDanger}, Dark={StaticResource FtDangerNight}}" />
                </Border>

                <Label Style="{StaticResource FtBodyMedium}"
                       Margin="0,16,0,0"
                       CharacterSpacing="0.286"
                       Text="{x:Static resources:AppResources.ManageSpaceContent}"
                       TextColor="{AppThemeBinding Light={StaticResource FtNavInactive}, Dark={StaticResource FtNavInactiveNight}}" />

                <Label Style="{StaticResource FtBodyMedium}"
                       Margin="0,16,0,0"
                       FontFamily="RobotoBold"
                       CharacterSpacing="0.286"
                       Text="{x:Static resources:AppResources.ManageSpaceWarning}"
                       TextColor="{AppThemeBinding Light={StaticResource FtTextPrimary}, Dark={StaticResource FtTextPrimaryNight}}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Padding="16,16,24,24"
                                   Spacing="8"
                                   HorizontalOptions="End">
                <Button Style="{StaticResource FtOutlinedButton}"
                        Padding="20,0"
                        Text="{x:Static resources:AppResources.ManageSpaceCancel}"
                        Clicked="OnCancelClicked" />
                <Button Style="{StaticResource FtDangerButton}"
                        Padding="20,0"
                        Text="{x:Static resources:AppResources.ManageSpaceButton}"
                        Clicked="OnClearDataClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
