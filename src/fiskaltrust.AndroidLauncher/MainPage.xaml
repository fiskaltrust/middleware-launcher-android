<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:fiskaltrust.AndroidLauncher.Resources"
             xmlns:controls="clr-namespace:fiskaltrust.AndroidLauncher.Controls"
             x:Class="fiskaltrust.AndroidLauncher.MainPage"
             Title="Home"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FtBackground}, Dark={StaticResource FtBackgroundNight}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:AppBar Grid.Row="0" Title="Home" />

        <VerticalStackLayout Grid.Row="1"
                             Padding="24,0"
                             Spacing="16"
                             VerticalOptions="Center">
            <Image x:Name="ftLogo"
                   Source="ft_badge.png"
                   Aspect="AspectFit"
                   HeightRequest="100"
                   WidthRequest="100"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="fiskaltrust" />

            <Label Style="{StaticResource FtHeadline}"
                   FontFamily="RobotoMedium"
                   Text="{x:Static resources:AppResources.MainTitle}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{x:Static resources:AppResources.MainContent}"
                   FontSize="15"
                   LineHeight="1.365"
                   MaximumWidthRequest="340"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <Label Grid.Row="2"
               x:Name="textViewVersion"
               Text="{Binding VersionText}"
               FontSize="11"
               LineHeight="1.241"
               Padding="24,16"
               TextColor="{AppThemeBinding Light={StaticResource FtTextSecondary}, Dark={StaticResource FtTextSecondaryNight}}"
               HorizontalTextAlignment="Center" />
    </Grid>

</ContentPage>
