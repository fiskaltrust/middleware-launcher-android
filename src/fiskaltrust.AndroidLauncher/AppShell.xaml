<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="fiskaltrust.AndroidLauncher.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:fiskaltrust.AndroidLauncher"
    xmlns:helpers="clr-namespace:fiskaltrust.AndroidLauncher.Helpers"
    Title="fiskaltrust.AndroidLauncher">
    <TabBar>
        <Tab Title="Home">
            <Tab.Icon>
                <FontImageSource FontFamily="{x:Static helpers:FaIcons.FontFamily}"
                                 Glyph="{x:Static helpers:FaIcons.House}"
                                 Size="20" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>
        <Tab Title="Logs">
            <Tab.Icon>
                <FontImageSource FontFamily="{x:Static helpers:FaIcons.FontFamily}"
                                 Glyph="{x:Static helpers:FaIcons.FileLines}"
                                 Size="20" />
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate local:LogsPage}"/>
        </Tab>
    </TabBar>

</Shell>
